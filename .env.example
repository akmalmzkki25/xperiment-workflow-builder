DATABASE_URL=postgresql://postgres:dev_password_change_me@localhost:5432/xperiment
REDIS_URL=redis://:dev_password_change_me@localhost:6379/0
API_PORT=3000
XPERIMENT_API_URL=http://localhost:3000
HTTP_ALLOW_PRIVATE_IPS=false
GATEWAY_PORT=3003
SCHEDULER_PORT=3004
SCHEDULER_INTERVAL_MS=5000
GATEWAY_URL=http://localhost:3003
# Read-only after the backfill: these decrypt enc_version = 0 rows only. They can be
# removed once `xperiment rekey` reports remaining=0 on all four encrypted columns.
TRIGGER_SECRET_KEY=xperiment-dev-trigger-secret-change-me
CREDENTIALS_SECRET_KEY=xperiment-dev-credentials-secret-change-me
NEXT_PUBLIC_API_URL=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_APP_URL=http://localhost:3005

# Billing (Phase 3O). The tax rate is a placeholder — a live deployment needs real tax
# advice. An unknown PAYMENT_PROVIDER fails at startup rather than per request.
INVOICE_TAX_RATE_BPS=1100
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=

# Envelope encryption (Phase 3P, SEC-001). `local` derives a root key from
# KEK_MASTER_KEY with scrypt; `gcp-kms` wraps through a Cloud KMS CryptoKey and requires
# KMS_KEY_NAME. Either misconfiguration fails at startup, not per request.
#
# With gcp-kms, KMS is a hard runtime dependency: if it is unreachable and a workspace
# key is not cached, credential resolution FAILS CLOSED rather than guessing. Cloud
# credentials come from the ambient environment only (GOOGLE_APPLICATION_CREDENTIALS or
# instance metadata) — never from a value committed here.
KMS_PROVIDER=local
KEK_MASTER_KEY=xperiment-dev-kek-master-change-me
# KMS_KEY_NAME=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY

# How long a decrypted workspace key stays in process memory. Lower means more KMS calls
# but faster propagation when a key is destroyed.
KEK_CACHE_TTL_MS=300000

# Platform mail (AUTH-002). `log` writes messages to the server log and sends nothing —
# it is the dev default and MUST NOT be used in production, where it would print
# password-reset links into the logs. `smtp` requires SMTP_HOST and MAIL_FROM, and a
# missing one fails the boot rather than every reset. Any other value fails at startup.
MAIL_TRANSPORT=log
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Base URL the emailed verification and reset links point at.
APP_URL=http://localhost:3005
