{
  "name": "xperiment-workflow-builder",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @xperiment/devstack start",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:cov": "pnpm -r --workspace-concurrency=1 test:cov",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter @xperiment/db migrate",
    "xperiment": "pnpm --filter @xperiment/cli xperiment --"
  }
}
